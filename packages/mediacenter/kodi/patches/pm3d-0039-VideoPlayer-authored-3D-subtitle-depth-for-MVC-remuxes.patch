     pPacket->iStreamId = stream->uniqueId;
     pPacket->demuxerId = GetDemuxerId();
   }
@@ -1806,6 +1816,7 @@ void CDVDDemuxFFmpeg::DisposeStreams()
     delete it->second;
   m_streams.clear();
