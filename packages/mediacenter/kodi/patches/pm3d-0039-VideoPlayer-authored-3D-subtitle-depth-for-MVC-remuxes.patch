From 8b4c086be65265f9d9e7ff5957c08251b4b2fe69 Mon Sep 17 00:00:00 2001
From: cinemaONE <35371193+cinema-ONE@users.noreply.github.com>
Date: Sat, 5 Sep 2026 20:10:53 +0200
Subject: [PATCH] VideoPlayer: authored 3D subtitle depth for MVC remuxes

The plane offsets a 3D Blu-ray asks for travel in the MVC dependent
view's SEI, so a matroska remux carries them too - only the playlist's
table saying which offset sequence a subtitle follows is lost. Read them
in the ffmpeg demuxer for a multiview H.264 stream (length-prefixed
access units, unlike the transport stream the Blu-ray demuxer walks) into
the same store, let the player take that store when no Blu-ray input
stream owns one, and follow sequence n for subtitle stream n, the order
the discs measured so far keep.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 .../DVDDemuxers/BlurayOffsetMetadata.cpp      | 31 +++++++++++++
 .../DVDDemuxers/BlurayOffsetMetadata.h        | 11 +++++
 .../DVDDemuxers/DVDDemuxFFmpeg.cpp            | 43 +++++++++++++++++++
 .../VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h  | 20 +++++++++
 xbmc/cores/VideoPlayer/VideoPlayer.cpp        | 35 +++++++++++++++
 5 files changed, 140 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.cpp
index e56b5d1c45..25337cdac6 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.cpp
@@ -162,6 +162,37 @@ bool ParseOffsetMetadata(const uint8_t* data, size_t size, OffsetMetadata& metad
   return false;
 }
 
+bool ParseOffsetMetadata(const uint8_t* data,
+                         size_t size,
+                         unsigned int nalLengthSize,
+                         OffsetMetadata& metadata)
+{
+  if (!data || nalLengthSize < 1 || nalLengthSize > 4)
+    return false;
+
+  size_t i{0};
+  while (i + nalLengthSize <= size)
+  {
+    size_t length{0};
+    for (unsigned int b = 0; b < nalLengthSize; ++b)
+      length = (length << 8) | data[i + b];
+    i += nalLengthSize;
+
+    if (length == 0 || length > size - i)
+      return false;
+
+    if ((data[i] & NAL_TYPE_MASK) == NAL_TYPE_SEI && length <= MAX_SEI_SIZE)
+    {
+      if (ParseSei(Unescape(data + i + 1, length - 1), metadata))
+        return true;
+    }
+
+    i += length;
+  }
+
+  return false;
+}
