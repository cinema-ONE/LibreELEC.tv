-      }
-#endif
+        FencePreSwap();
 
       if (!m_eglContext.TrySwapBuffers())
       {
@@ -147,15 +136,8 @@ void CWinSystemGbmGLContext::PresentRender(bool rendered, bool videoLayer)
         throw std::runtime_error("eglSwapBuffers failed");
       }
 
-#if defined(EGL_ANDROID_native_fence_sync) && defined(EGL_KHR_fence_sync)
       if (async)
-      {
-        int fd = m_eglFence->FlushFence();
-        m_DRM->SetInFenceFd(fd);
-
-        m_eglFence->WaitSyncCPU();
-      }
-#endif
+        FencePostSwap();
     }
 
     CWinSystemGbm::FlipPage(rendered, videoLayer, async);
