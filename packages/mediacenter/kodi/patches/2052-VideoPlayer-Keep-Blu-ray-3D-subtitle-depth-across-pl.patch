From 60277ae10bf9a9c027c239e9d4c046ca8c8084b7 Mon Sep 17 00:00:00 2001
From: cinemaONE <35371193+cinema-ONE@users.noreply.github.com>
Date: Fri, 30 Oct 2026 10:56:31 +0100
Subject: [PATCH 2052/2064] [VideoPlayer] Keep Blu-ray 3D subtitle depth across
 play items

Subtitles went flat from the moment the demuxer reached the next play
item until playback reached the one after it: the 3D demuxer emptied
the offset store whenever it reopened the dependent view, about 16 s
before the old item had finished showing, and the lookup added the
current timestamp correction, which already belonged to the new clip.

Keep the store across clip changes (a seek still flushes it) and give
each block the correction of the clip it came from.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 867569132306e5d4b9ca00d1c776ad5d9ea8f9b1)
---
 .../DVDDemuxers/BlurayOffsetMetadata.cpp      | 20 +++++++++++++--
 .../DVDDemuxers/BlurayOffsetMetadata.h        |  7 +++++-
 .../DVDDemuxers/DVDDemuxBluray3D.cpp          |  4 ---
 .../test/TestBlurayOffsetMetadata.cpp         | 25 +++++++++++++++++++
 xbmc/cores/VideoPlayer/VideoPlayer.cpp        | 13 +++++++---
 xbmc/cores/VideoPlayer/VideoPlayer.h          |  4 +--
 6 files changed, 60 insertions(+), 13 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.cpp
index 57591d80e6..82bf47aa10 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.cpp
@@ -214,7 +214,7 @@ void COffsetMetadataStore::Add(double startPts, double frameDuration, OffsetMeta
 
   std::unique_lock lock(m_section);
 
-  m_entries.push_back({startPts, frameDuration, std::move(metadata)});
+  m_entries.push_back({startPts, frameDuration, std::move(metadata), std::nullopt});
   while (m_entries.size() > MAX_ENTRIES)
     m_entries.pop_front();
 }
@@ -231,6 +231,18 @@ void COffsetMetadataStore::NoteFrame(double pts)
     newest.startPts = pts;
 }
 
+void COffsetMetadataStore::ApplyCorrection(double correction)
+{
+  std::unique_lock lock(m_section);
+
+  for (SEntry& entry : m_entries | std::views::reverse)
+  {
+    if (entry.correction)
+      break;
+    entry.correction = correction;
+  }
+}
+
 int COffsetMetadataStore::GetOffset(double pts, unsigned int sequence) const
 {
   std::unique_lock lock(m_section);
@@ -238,7 +250,11 @@ int COffsetMetadataStore::GetOffset(double pts, unsigned int sequence) const
   // Most recent first: after a loop or a stream change the newer entry is the wanted one.
   for (const SEntry& entry : m_entries | std::views::reverse)
   {
-    const long frame{std::lround((pts - entry.startPts) / entry.frameDuration)};
+    if (!entry.correction)
+      continue;
+
+    const double startPts{entry.startPts - *entry.correction};
+    const long frame{std::lround((pts - startPts) / entry.frameDuration)};
     if (frame >= 0 && frame < static_cast<long>(entry.metadata.frames))
       return entry.metadata.Offset(sequence, static_cast<unsigned int>(frame));
   }
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.h b/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.h
index 9633a99c23..43f193dab2 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.h
@@ -92,7 +92,11 @@ public:
   //!        frame shown, which in an open GOP is a leading frame decoded after the carrier.
   void NoteFrame(double pts);
 
-  //! \brief The offset a sequence asks for at \p pts, or 0 when nothing describes it.
+  //! \brief The player's timestamp correction for the blocks added since the last call.
+  void ApplyCorrection(double correction);
+
+  //! \brief The offset a sequence asks for at the corrected time \p pts, or 0 when nothing
+  //!        describes it.
   int GetOffset(double pts, unsigned int sequence) const;
 
   void Flush();
@@ -109,6 +113,7 @@ private:
     double startPts{0.0};
     double frameDuration{0.0};
     OffsetMetadata metadata;
+    std::optional<double> correction;
   };
 
   mutable CCriticalSection m_section;
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.cpp
index 606a35a5d7..7f313d27f5 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.cpp
@@ -225,9 +225,6 @@ void CDVDDemuxBluray3D::CloseDependentView()
     m_pendingDependent = nullptr;
   }
 
-  // The offsets describe the play item being left behind.
-  m_bluray->GetOffsetMetadata()->Flush();
-
   {
     std::unique_lock lock(m_dependentSection);
     m_dependent.reset();
@@ -506,7 +503,6 @@ void CDVDDemuxBluray3D::PlaceDependent(double targetMs)
 
   m_dependentEnded = false;
   m_unmergedBase = 0;
-  m_bluray->GetOffsetMetadata()->Flush();
 
   if (!m_dependent)
     return;
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/test/TestBlurayOffsetMetadata.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/test/TestBlurayOffsetMetadata.cpp
index c4e0dfa7c7..3bf09f249b 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/test/TestBlurayOffsetMetadata.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/test/TestBlurayOffsetMetadata.cpp
@@ -163,6 +163,7 @@ TEST(TestBlurayOffsetMetadata, StoreFindsTheFrameAtATime)
 
   COffsetMetadataStore store;
   store.Add(5000.0, FRAME, std::move(metadata));
+  store.ApplyCorrection(0.0);
 
   EXPECT_EQ(store.GetOffset(5000.0, 0), 1);
   EXPECT_EQ(store.GetOffset(6000.0, 0), 2);
@@ -185,6 +186,7 @@ TEST(TestBlurayOffsetMetadata, StoreStartsAnOpenGopAtItsFirstShownFrame)
   // Carried by the keyframe at 5000; a leading frame decoded after it is shown one frame earlier.
   COffsetMetadataStore store;
   store.Add(5000.0, FRAME, std::move(metadata));
+  store.ApplyCorrection(0.0);
   store.NoteFrame(4000.0);
 
   EXPECT_EQ(store.GetOffset(4000.0, 0), 1);
@@ -203,6 +205,7 @@ TEST(TestBlurayOffsetMetadata, StoreIgnoresAFrameFarBeforeTheNewestBlock)
   COffsetMetadataStore store;
   store.NoteFrame(0.0);
   store.Add(50000.0, FRAME, std::move(metadata));
+  store.ApplyCorrection(0.0);
 
   // Too far back for a leading frame: a loop or a timestamp jump.
   store.NoteFrame(20000.0);
@@ -217,6 +220,7 @@ TEST(TestBlurayOffsetMetadata, StoreForgetsWhatItIsToldTo)
 
   COffsetMetadataStore store;
   store.Add(0.0, FRAME, std::move(metadata));
+  store.ApplyCorrection(0.0);
   EXPECT_EQ(store.GetOffset(0.0, 0), 4);
 
   store.Flush();
@@ -233,6 +237,7 @@ TEST(TestBlurayOffsetMetadata, StoreKeepsTheMostRecentBlocks)
     OffsetMetadata metadata;
     ASSERT_TRUE(Parse(AccessUnit({0x40}, 1, 1, {static_cast<uint8_t>(1 + i % 9)}), metadata));
     store.Add(i * FRAME, FRAME, std::move(metadata));
+    store.ApplyCorrection(0.0);
   }
 
   EXPECT_EQ(store.GetOffset(99 * FRAME, 0), 1 + 99 % 9);
@@ -257,3 +262,23 @@ TEST(TestBlurayOffsetMetadata, RejectsATagThatNamesNoSequence)
   EXPECT_FALSE(ParseOffsetSequenceTag(" 2").has_value());
   EXPECT_FALSE(ParseOffsetSequenceTag("4294967296").has_value());
 }
+
+TEST(TestBlurayOffsetMetadata, StoreKeysABlockByTheCorrectionOfItsOwnClip)
+{
+  OffsetMetadata first;
+  ASSERT_TRUE(Parse(AccessUnit({0x40}, 1, 2, {3, 3}), first));
+  OffsetMetadata second;
+  ASSERT_TRUE(Parse(AccessUnit({0x40}, 1, 2, {7, 7}), second));
+
+  // The next clip restarts its timestamps; the player corrects them once the jump is confirmed.
+  COffsetMetadataStore store;
+  store.Add(50000.0, FRAME, std::move(first));
+  store.ApplyCorrection(0.0);
+  store.Add(5000.0, FRAME, std::move(second));
+  EXPECT_EQ(store.GetOffset(5000.0, 0), 0);
+  store.ApplyCorrection(-47000.0);
+
+  EXPECT_EQ(store.GetOffset(51000.0, 0), 3);
+  EXPECT_EQ(store.GetOffset(52000.0, 0), 7);
+  EXPECT_EQ(store.GetOffset(5000.0, 0), 0);
+}
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index d351f976c9..504b09783b 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -2038,6 +2038,15 @@ void CVideoPlayer::ProcessVideoData(CDemuxStream* pStream, DemuxPacket* pPacket)
     checkcont = CheckContinuity(m_CurrentVideo, pPacket);
     UpdateTimestamps(m_CurrentVideo, pPacket);
   }
+
+  // A packet whose timestamps await confirmation of a jump leaves its block pending.
+  if (pPacket->dts != DVD_NOPTS_VALUE)
+  {
+    std::unique_lock lock(m_offsetMetadataSection);
+    if (m_offsetMetadata)
+      m_offsetMetadata->ApplyCorrection(m_offset_pts);
+  }
+
   if (checkcont && (m_CurrentVideo.avsync == CCurrentStream::AV_SYNC_CHECK))
     m_CurrentVideo.avsync = CCurrentStream::AV_SYNC_NONE;
 
@@ -4678,9 +4687,7 @@ std::optional<int> CVideoPlayer::GetSubtitlePlaneOffset(double pts)
   if (!m_offsetMetadata)
     return std::nullopt;
 
-  // The store is keyed by the demuxer's timestamps and this is a presentation time, which
-  // ReadPacket() has already had m_offset_pts taken off (see UpdateCorrection).
-  return m_offsetMetadata->GetOffset(pts + m_offset_pts, static_cast<unsigned int>(sequence));
+  return m_offsetMetadata->GetOffset(pts, static_cast<unsigned int>(sequence));
 }
 
 bool CVideoPlayer::OpenSubtitleStream(const CDVDStreamInfo& hint)
