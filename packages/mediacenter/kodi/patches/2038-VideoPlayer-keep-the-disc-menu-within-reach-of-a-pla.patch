 xbmc/application/ApplicationPlayer.h          |  1 +
 xbmc/cores/IPlayer.h                          |  7 +++
 .../DVDInputStreams/DVDInputStreamBluray.cpp  | 13 +++++
 .../DVDInputStreams/DVDInputStreamBluray.h    | 11 ++++
