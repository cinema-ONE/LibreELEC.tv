+bool CDVDVideoCodecDRMPRIME::GetCodecStats(double& pts, int& droppedFrames, int& skippedPics)
+{
+  pts = m_decoderPts;
+
+  droppedFrames = m_droppedFrames ? m_droppedFrames : -1;
+  m_droppedFrames = 0;
+
+  // no post processing that can be skipped independently of the decode
+  skippedPics = -1;
+
+  return true;
+}
