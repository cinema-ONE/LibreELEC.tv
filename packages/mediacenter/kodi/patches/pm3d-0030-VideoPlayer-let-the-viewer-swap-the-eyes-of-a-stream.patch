From 495c7dcb3b1164e2c4fdecdc004bf2ea96127f37 Mon Sep 17 00:00:00 2001
From: Dom Cobley <popcornmix@gmail.com>
Date: Thu, 3 Sep 2026 16:06:59 +0100
Subject: [PATCH 06/12] VideoPlayer: let the viewer swap the eyes of a stream
 that declares its own layout

"Invert stereoscopic 3D mode (flip eyes)" was only read when the picture arrived without a
layout, which is to say only when the setting beside it was being used to tell Kodi how to
read a file that says nothing. Anything that declares its own layout took the other branch
and the toggle did nothing at all.

That is precisely the case where a viewer needs it. A Blu-ray 3D playlist names which coded
view is the left eye and a Matroska file carries a StereoMode, and either can be wrong -
there is nothing to check them against, and a disc that says its base view is the left eye
when it is the right one leaves every scene inside out with no way back. Half-SBS and
half-TAB files mislabelled by whoever packed them are the same problem.

So invert whatever layout the picture ends up with, from wherever it came. The two settings
now compose the way they read: one says how the frame is packed, the other says the eyes are
the other way round.

Verified on a retail Blu-ray 3D disc, where the title plays as left_right, reports
right_left with the toggle on, and left_right again with it off.

(cherry picked from commit dca1c60312818d3967bfa3787875a8e019d20640)
---
 xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp | 32 ++++++++++++++++++---
 1 file changed, 28 insertions(+), 4 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp b/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
index 556f4049eb..956c4108c0 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
@@ -25,6 +25,7 @@
 
 #include <iomanip>
 #include <iterator>
+#include <map>
 #include <memory>
 #include <mutex>
 #include <numeric>
@@ -32,6 +33,23 @@
 
 using namespace std::chrono_literals;
 
+namespace
+{
+//! rief Name the same packed layout with the eyes the other way round.
+std::string SwapStereoscopicEyes(const std::string& stereoMode)
+{
+  static const std::map<std::string, std::string, std::less<>> swapped{
+      {"left_right", "right_left"},
+      {"right_left", "left_right"},
+      {"top_bottom", "bottom_top"},
+      {"bottom_top", "top_bottom"},
+  };
+
+  const auto it{swapped.find(stereoMode)};
+  return it == swapped.end() ? stereoMode : it->second;
+}
+} // namespace
+
 class CDVDMsgVideoCodecChange : public CDVDMsg
 {
 public:
@@ -628,6 +646,11 @@ void CVideoPlayerVideo::UpdatePlayerInfo()
 
 bool CVideoPlayerVideo::ProcessDecoderOutput(double &frametime, double &pts)
 {
+  // The picture is reused from one frame to the next and not every decoder writes the stereo
+  // mode, while the hint fallback below runs on what it finds here - as does the viewer's eye
+  // swap - so start each frame with nothing left over from the one before.
+  m_picture.stereoMode.clear();
+
   CDVDVideoCodec::VCReturn decoderState = m_pVideoCodec->GetPicture(&m_picture);
 
   if (decoderState == CDVDVideoCodec::VC_BUFFER)
@@ -727,13 +750,9 @@ bool CVideoPlayerVideo::ProcessDecoderOutput(double &frametime, double &pts)
       {
         case RenderStereoMode::SPLIT_VERTICAL:
           stereoMode = "left_right";
-          if (m_processInfo.GetVideoSettings().m_StereoInvert)
-            stereoMode = "right_left";
           break;
         case RenderStereoMode::SPLIT_HORIZONTAL:
           stereoMode = "top_bottom";
-          if (m_processInfo.GetVideoSettings().m_StereoInvert)
-            stereoMode = "bottom_top";
           break;
         default:
           stereoMode = m_hints.stereo_mode;
@@ -745,6 +764,11 @@ bool CVideoPlayerVideo::ProcessDecoderOutput(double &frametime, double &pts)
       }
     }
 
+    // A stream that states its own layout can state it wrongly, and a viewer looking at
+    // swapped eyes has nothing else to correct it with.
+    if (m_processInfo.GetVideoSettings().m_StereoInvert)
+      m_picture.stereoMode = SwapStereoscopicEyes(m_picture.stereoMode);
+
     // if frame has a pts (usually originating from demux packet), use that
     if (m_picture.pts != DVD_NOPTS_VALUE)
     {
