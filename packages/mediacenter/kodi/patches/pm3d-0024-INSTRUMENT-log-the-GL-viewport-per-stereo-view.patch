From 3104a8f8dc31a3378fca1ca24f5dc453846885c8 Mon Sep 17 00:00:00 2001
From: cinemaONE <35371193+cinema-ONE@users.noreply.github.com>
Date: Sat, 5 Sep 2026 15:33:41 +0200
Subject: [PATCH] INSTRUMENT: log the GL viewport per stereo view

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 xbmc/rendering/gles/RenderSystemGLES.cpp | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/xbmc/rendering/gles/RenderSystemGLES.cpp b/xbmc/rendering/gles/RenderSystemGLES.cpp
index 6036c2251e..4477111eea 100644
--- a/xbmc/rendering/gles/RenderSystemGLES.cpp
+++ b/xbmc/rendering/gles/RenderSystemGLES.cpp
@@ -380,6 +380,18 @@ void CRenderSystemGLES::SetViewPort(const CRect& viewPort)
 
   glScissor((GLint) viewPort.x1, (GLint) (m_height - viewPort.y1 - viewPort.Height()), (GLsizei) viewPort.Width(), (GLsizei) viewPort.Height());
   glViewport((GLint) viewPort.x1, (GLint) (m_height - viewPort.y1 - viewPort.Height()), (GLsizei) viewPort.Width(), (GLsizei) viewPort.Height());
+  // INSTRUMENT (3D layout investigation): one line per ~2 s
+  {
+    static unsigned int s_calls = 0;
+    if ((s_calls++ % 200) < 4)
+      CLog::Log(LOGINFO,
+                "STEREOVP SetViewPort: rect=({:.0f},{:.0f} {:.0f}x{:.0f}) gl=({},{} {}x{}) sys={}x{} view={}",
+                viewPort.x1, viewPort.y1, viewPort.Width(), viewPort.Height(),
+                static_cast<int>(viewPort.x1),
+                static_cast<int>(m_height - viewPort.y1 - viewPort.Height()),
+                static_cast<int>(viewPort.Width()), static_cast<int>(viewPort.Height()), m_width,
+                m_height, static_cast<int>(m_stereoView));
+  }
   m_viewPort[0] = viewPort.x1;
   m_viewPort[1] = m_height - viewPort.y1 - viewPort.Height();
   m_viewPort[2] = viewPort.Width();
-- 
2.55.0

