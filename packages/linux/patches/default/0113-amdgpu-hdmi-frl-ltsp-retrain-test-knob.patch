+bool hdmi_frl_start_video_with_retrain(struct dc_link *link)
+{
+	int attempt;
+
+	DC_LOGGER_INIT(link->ctx->logger);
+
+	for (attempt = 1; ; attempt++) {
+		link->hpo_frl_link_enc->funcs->enable_output(link->hpo_frl_link_enc);
+		if (link->frl_flags.apply_vsdb_rcc_wa)
+			link->hpo_frl_link_enc->funcs->apply_vsdb_rcc_wa(link->hpo_frl_link_enc);
+		if (hdmi_frl_poll_start(link->ddc))
+			return true;
+		if (attempt >= 3) {
+			FRL_INFO("FRL LINK TRAINING:  LTS:P no FRL_START after %d trainings; enabling video anyway\n",
+					attempt);
+			return false;
+		}
+		FRL_INFO("FRL LINK TRAINING:  LTS:P retraining, attempt %d\n", attempt + 1);
+		if (hdmi_frl_perform_link_training_with_retries(link) != LINK_RESULT_SUCCESS) {
+			FRL_INFO("FRL LINK TRAINING:  LTS:P retraining failed; enabling video anyway\n");
+			return false;
+		}
+	}
 }
 
