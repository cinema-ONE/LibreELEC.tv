- * Hades: the HDR10+ packet of a connector state for a stream's link (amdgpu_dm_hdr10plus.h):
- * invalid without HDR10PLUS_VSIF, and on a link that does not carry it, which the atomic check
- * refuses on a stream that exists.
- */
-static void amdgpu_dm_fill_hdr10plus(const struct drm_connector_state *state,
-				     enum signal_type signal, struct dc_info_packet *out)
-{
-	const struct drm_property_blob *blob = state->hdr10plus_vsif;
-
-	memset(out, 0, sizeof(*out));
-	if (!blob || !amdgpu_dm_hdr10plus_link(signal))
-		return;
-	amdgpu_dm_hdr10plus_packet(blob->data, blob->length, dc_is_hdmi_signal(signal), out);
-}
-
