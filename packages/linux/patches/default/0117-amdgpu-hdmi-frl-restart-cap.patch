 		pr_info("amdgpu: cinemaONE FRL status poll: forced stream restart\n");
-		link_restart_all_streams_for_link(link);
-		frl_last_restart = jiffies;
+		frl_restart_streams(link);
 		return false;
 	}
 	if (scdc_update.fields.FLT_UPDATE && frl_retrain_in_place == 2 &&
@@ -295,6 +339,13 @@ bool hdmi_frl_poll_status_flag(struct dc_link *link)
 		ln2_pattern = ltp_req.fields.LN2_LTP_REQ;
 		ln3_pattern = ltp_req.fields.LN3_LTP_REQ;
 
