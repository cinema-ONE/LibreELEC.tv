link_hdmi_frl.c, above `static int frl_restart_cap = 30;`:
Safety cap (cinemaONE, 2026-09-27), for dc_hpo_frl_retrain_in_place=2: a
sink that never settles would have its streams restarted forever. Through
the VRROOM the longest run of requests was 17 restarts in 5.7 s.
  dc_hpo_frl_restart_cap: after this many restarts within
    dc_hpo_frl_restart_cap_ms, serve no more FLT_Update (it stays set, the
    encoder untouched) until the next link enable that is not one of these
    restarts -- the next mode set -- and say so once; 0 = no cap
Forced restarts (dc_hpo_frl_force_restart) are not counted.

diff --git a/drivers/gpu/drm/amd/display/dc/link/protocols/link_hdmi_frl.c b/drivers/gpu/drm/amd/display/dc/link/protocols/link_hdmi_frl.c
index 5e62e12..4c9c20d 100644
--- a/drivers/gpu/drm/amd/display/dc/link/protocols/link_hdmi_frl.c
+++ b/drivers/gpu/drm/amd/display/dc/link/protocols/link_hdmi_frl.c
@@ -76,6 +76,51 @@ module_param_named(dc_hpo_frl_force_restart, frl_force_restart, int, 0644);
 MODULE_PARM_DESC(dc_hpo_frl_force_restart,
 		 "HDMI FRL status poll, restart mode: write 1 to restart the streams once at the next poll round");
 static unsigned long frl_last_restart;
+
+static int frl_restart_cap = 30;
+module_param_named(dc_hpo_frl_restart_cap, frl_restart_cap, int, 0644);
+MODULE_PARM_DESC(dc_hpo_frl_restart_cap,
+		 "HDMI FRL status poll, restart mode: stop after this many restarts within dc_hpo_frl_restart_cap_ms until the next mode set (default 30, 0 = no cap)");
+static int frl_restart_cap_ms = 20000;
+module_param_named(dc_hpo_frl_restart_cap_ms, frl_restart_cap_ms, int, 0644);
+MODULE_PARM_DESC(dc_hpo_frl_restart_cap_ms,
+		 "HDMI FRL status poll, restart mode: the cap's window in ms (default 20000)");
+static unsigned long frl_cap_window_start;
+static int frl_cap_count;
+static bool frl_capped;
+static bool frl_in_restart;
+
+/* One more restart, or none: the cap's verdict, counted when it says yes. */
+static bool frl_restart_allowed(void)
+{
+	unsigned long now = jiffies;
+
+	if (frl_capped)
+		return false;
+	if (frl_restart_cap <= 0)
+		return true;
+	if (frl_cap_count == 0 ||
+	    time_after(now, frl_cap_window_start + msecs_to_jiffies(frl_restart_cap_ms))) {
+		frl_cap_window_start = now;
+		frl_cap_count = 0;
+	}
+	if (frl_cap_count >= frl_restart_cap) {
+		frl_capped = true;
+		pr_info("amdgpu: cinemaONE FRL status poll: %d restarts in %u ms, the cap; no more until the next mode set\n",
+			frl_cap_count, jiffies_to_msecs(now - frl_cap_window_start));
+		return false;
+	}
+	frl_cap_count++;
+	return true;
+}
+
+static void frl_restart_streams(struct dc_link *link)
+{
+	frl_in_restart = true;
+	link_restart_all_streams_for_link(link);
+	frl_in_restart = false;
+	frl_last_restart = jiffies;
+}
 MODULE_PARM_DESC(dc_hpo_frl_retrain_in_place,
 		 "HDMI FRL status poll: 0 retrain then RETRAIN detect (upstream), 1 retrain then LTS:P in place, 2 streams off and on again; no detect for 1 and 2");
 
