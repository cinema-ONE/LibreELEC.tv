+static bool is_master_pipe_for_link(const struct dc_link *link,
+		const struct pipe_ctx *pipe);
+
+void link_set_streams_dpms_on_for_link(struct dc_link *link,
+		struct dc_stream_state *streams[], uint8_t count)
+{
+	struct dc_stream_update stream_update;
+	bool dpms_off = false;
+	int i, j;
+
+	memset(&stream_update, 0, sizeof(stream_update));
+	stream_update.dpms_off = &dpms_off;
+
+	for (i = 0; i < count; i++) {
+		bool off_here = false;
+
+		for (j = 0; j < MAX_PIPES; j++) {
+			struct pipe_ctx *pipe = &link->dc->current_state->res_ctx.pipe_ctx[j];
+
+			if (pipe->stream == streams[i] && is_master_pipe_for_link(link, pipe))
+				off_here = streams[i]->dpms_off;
+		}
+		if (!off_here)
+			continue;
+		stream_update.stream = streams[i];
+		dc_commit_updates_for_stream(link->ctx->dc, NULL, 0,
+				streams[i], &stream_update,
+				link->dc->current_state);
+	}
+}
